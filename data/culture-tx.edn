#:culture{:url "https://en.wikipedia.org/wiki/Thieboudienne", :id "sen.dish.thieboudienne", :kind :dish, :name-local "Ceebu jën", :country "SEN", :retrieved-at "2026-07-17", :summary "One-pot dish of fish, broken rice and tomato sauce; the article states it is the national dish of Senegal, originating in Saint-Louis, and UNESCO has recognized Ceebu Jen as an intangible cultural heritage.", :name "Thieboudienne", :url-provenance :wikipedia-en}
#:culture{:id "sen.dish.yassa", :name "Yassa", :country "SEN", :kind :dish, :summary "Spicy dish of marinated poultry, fish or lamb with onions and lemon or mustard; the article states it is originally from Senegal and one of the most iconic dishes of Senegalese cuisine, since spread throughout West Africa.", :url "https://en.wikipedia.org/wiki/Yassa_(food)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Peanut_stew", :id "sen.dish.mafe", :kind :dish, :name-local "Maafe", :country "SEN", :retrieved-at "2026-07-17", :summary "Staple West African groundnut stew (Wolof mafe); the article states the dish originates from Senegal, though a stew of similar name (tigadeguena) also originated in Mali, and maafe subsequently spread across the region.", :name "Peanut stew", :url-provenance :wikipedia-en}
#:culture{:url "https://en.wikipedia.org/wiki/Caf%C3%A9_Touba", :id "sen.beverage.cafe-touba", :kind :beverage, :name-local "Café Touba", :country "SEN", :retrieved-at "2026-07-17", :summary "Coffee flavored with grains of Selim (locally djar) and named for the city of Touba; traditionally consumed by the Mouride Islamic brotherhood since its founder returned from exile in 1902, and served during ceremonies and the Grand Magal of Touba.", :name "Cafe Touba", :url-provenance :wikipedia-en}
#:culture{:url "https://en.wikipedia.org/wiki/Senegalese_kaftan", :id "sen.craft.senegalese-kaftan", :kind :craft, :name-local "Mbubb", :country "SEN", :retrieved-at "2026-07-17", :summary "Pullover men's robe with long bell sleeves, ankle-length, commonly made of cotton brocade or lace and paired with matching tubay pants; called mbubb or xaftaan in Wolof and boubou in French, worn as formal wear across West Africa.", :name "Senegalese kaftan", :url-provenance :wikipedia-en}
#:culture{:url "https://en.wikipedia.org/wiki/Senegalese_wrestling", :id "sen.festival.senegalese-wrestling", :kind :festival, :name-local "Laamb", :country "SEN", :retrieved-at "2026-07-17", :summary "Folk wrestling traditionally performed by the Serer people, called Laamb in Wolof; holds the status of national sport in Senegal, with matches including ceremonial performances and the bakk oral boasting art, and has become a major spectator event since the 1950s.", :name "Senegalese wrestling", :url-provenance :wikipedia-en}
#:culture{:url "https://en.wikipedia.org/wiki/Gor%C3%A9e", :id "sen.heritage.goree", :kind :heritage, :name-local "Île de Gorée", :country "SEN", :retrieved-at "2026-07-17", :summary "Small island off the coast of Dakar, designated a UNESCO World Heritage Site in 1978 as one of the first 12 locations so designated worldwide; a memorial to the transatlantic slave trade and Senegal's premier tourist site.", :name "Island of Goree", :url-provenance :wikipedia-en}
